{"cursor":24,"data":{"argv":["/usr/local/bin/python3.12","-I","-S","-X","utf8","-c","# Search for a linear checksum letter formula\n# letter_value = (p*L1+q*L2+a*d1+b*d2+c*d3 + k) mod 26, map 1..26 -> A..Z (0->Z)\n# Need 18 (R) for QT456 and XY001; for AB123 need != 24 (X) if X is the invalid letter.\n\ndef val(letters):\n    return [ord(c)-64 for c in letters]\n\nsols=[]\nfor p in range(-3,4):\n  for q in range(-3,4):\n    for a in range(-3,4):\n      for b in range(-3,4):\n        for c in range(-3,4):\n          for k in range(0,26):\n            def cv(L,d):\n                lv=val(L)\n                v=p*lv[0]+q*lv[1]+a*d[0]+b*d[1]+c*d[2]+k\n                v%=26\n                if v==0: v=26\n                return v\n            r1=cv(\"QT\",[4,5,6])\n            r2=cv(\"XY\",[0,0,1])\n            r3=cv(\"AB\",[1,2,3])\n            if r1==18 and r2==18 and r3!=24:\n                sols.append((p,q,a,b,c,k,r3))\nprint(len(sols))\nfor s in sols[:30]:\n    print(s)"],"argv_truncated":false,"binary_path":"/usr/local/bin/python3.12","cwd":"/rush/workspace","start_time":1795496155732328000,"tgid":218,"time_ns":2925473028421458},"event_id":"process-000008","kind":"process.exec","occurred_ns":"2925473028421458","payload_sha256s":[],"received_at":"2026-11-24T04:57:02.814Z","sequence":8,"source":"process"}
